# Example configuration only. Copy to .env and replace all change-me values.
#
# APPLICATION
#
APP_NAME=xiaowen-backend
APP_SCHEMA=http
APP_HOST=localhost
APP_PORT=10100
APP_ROUTE_PREFIX=/api
APP_BANNER=true

#
# LOGGING
#
LOG_LEVEL=debug
LOG_OUTPUT=dev

#
# Status Monitor
#
MONITOR_ENABLED=false
MONITOR_ROUTE=/status
MONITOR_USERNAME=admin
MONITOR_PASSWORD=change-me

#
# DATABASE - MySQL
#
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=xiaowen
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me
MYSQL_LOGGING=false

#
# MINIO
#
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET_NAME=pic

#
# Baidu Translation
#
BAIDU_TRANSLATION_APP_ID=change-me
BAIDU_TRANSLATION_SECRET_KEY=change-me
BAIDU_TRANSLATION_ENDPOINT=https://fanyi-api.baidu.com
BAIDU_TRANSLATION_PATH=/api/trans/vip/translate

#
# WX
#
WECHAT_MINI_PROGRAM_APP_ID=change-me
WECHAT_MINI_PROGRAM_SECRET=change-me

#
# JWT
#
SECRET_JWT=change-me

#
# Generate server
#
GENERATE_SERVER_URL=http://localhost:7860
